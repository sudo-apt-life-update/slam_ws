<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_locomotion</name>
  <version>0.0.0</version>
  <description>
    Odometry and velocity control for the G1: the ROS side of g1_loco_server.

    Copied 2026-08-19 from waypoint_follow_ws/src/g1_walk so slam_ws runs
    standalone. That workspace keeps the original and is unchanged.
  </description>
  <maintainer email="cs.sharma2112@gmail.com">Charu</maintainer>
  <license>MIT License</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-zmq</exec_depend>
  <exec_depend>g1_loco_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
